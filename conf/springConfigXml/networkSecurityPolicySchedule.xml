<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
       http://zstack.org/schema/zstack
       http://zstack.org/schema/zstack/plugin.xsd"
       default-init-method="init"
       default-destroy-method="destroy">

    <bean id="NetworkSecurityPolicyScheduleApiInterceptor"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleApiInterceptor">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.apimediator.ApiMessageInterceptor"/>
        </zstack:plugin>
    </bean>

    <bean id="NetworkSecurityPolicyScheduleManager"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleManagerImpl">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.Service"/>
        </zstack:plugin>
    </bean>

    <bean id="NetworkSecurityPolicyScheduleFacade"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleFacade"/>

    <bean id="NetworkSecurityPolicyScheduleResourceBackendRegistry"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleResourceBackendRegistry">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
        </zstack:plugin>
    </bean>

    <bean id="NetworkSecurityPolicyScheduleScanTask"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleScanTask">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
        </zstack:plugin>
    </bean>

    <bean id="NetworkSecurityPolicyScheduleCascadeExtension"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleCascadeExtension">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.core.cascade.CascadeExtensionPoint"/>
        </zstack:plugin>
    </bean>

    <bean id="NetworkSecurityPolicyScheduleSecurityGroupExtension"
          class="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleSecurityGroupExtension">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.network.securitygroup.SecurityGroupRuleFilterExtensionPoint"/>
            <zstack:extension interface="org.zstack.networksecuritypolicyschedule.NetworkSecurityPolicyScheduleResourceBackend"/>
        </zstack:plugin>
    </bean>
</beans>
