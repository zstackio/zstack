<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
    http://zstack.org/schema/zstack
    http://zstack.org/schema/zstack/plugin.xsd">

    <bean id="HostSecretEnvelopeCrypto" class="org.zstack.crypto.envelope.HostSecretEnvelopeCrypto">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.secret.HostSecretEnvelopeCryptoExtensionPoint" />
        </zstack:plugin>
    </bean>

    <bean id="KVMEnvelopeKeySyncExtension" class="org.zstack.crypto.envelope.KVMEnvelopeKeySyncExtension">
        <property name="restf" ref="RESTFacade"/>
        <property name="dbf" ref="databaseFacade"/>
        <zstack:plugin>
            <zstack:extension interface="org.zstack.kvm.KVMPingAgentExtensionPoint" />
        </zstack:plugin>
    </bean>
</beans>
