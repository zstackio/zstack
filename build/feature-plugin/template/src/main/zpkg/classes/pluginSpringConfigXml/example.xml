<?xml version="1.0" encoding="UTF-8"?>
<!-- Files under src/main/zpkg are packed as they are; classes/ goes to WEB-INF/classes of the management node.
     Declare plugin beans here and the SDK interfaces they implement as extensions. -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
    http://zstack.org/schema/zstack
    http://zstack.org/schema/zstack/plugin.xsd"
       default-init-method="init" default-destroy-method="destroy">

    <bean id="ExampleUsageChecker" class="org.zstack.plugin.example.ExampleUsageChecker">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.plugin.sdk.PluginUsageChecker"/>
        </zstack:plugin>
    </bean>

    <bean id="ExampleTransactional" class="org.zstack.plugin.example.ExampleTransactional"/>
</beans>
