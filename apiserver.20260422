cat <<'EOF' >/etc/systemd/system/zstnlet.service
[Unit]
Description=ZStone Agent Service
After=rc-local.service

[Service]
Type=simple
Restart=always
RestartSec=1
StartLimitInterval=0
LimitNOFILE=65535
LimitCORE=infinity
ExecStart=/opt/zstone/bin/zstnlet work --config /opt/zstone/conf/zstnlet.yaml

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload;
systemctl enable --now zstnlet;

