Apr 22 18:47:13.079[36m [INFO] [0m#!/bin/bash

function getOsVersionInfo() {
    if [ -f /etc/redhat-release ]; then
        #OS_VERSION=$(cat /etc/redhat-release|grep -Po  "(\d[\d.]*)")
        OS_VERSION=$(grep -oE '[0-9]+\.[0-9]+' /etc/redhat-release)
        if [ $? != 0 ];then
            OS_VERSION=
        fi
        OS=$(cat /etc/redhat-release|awk '{print $1}')
        if [ $? != 0 ];then
            OS=
        fi
    elif [ -f /etc/os-release ]; then
        # freedesktop.org and systemd
        . /etc/os-release
        OS=$NAME
        OS_VERSION=$VERSION_ID
    elif type lsb_release >/dev/null 2>&1; then
        # linuxbase.org
        OS=$(lsb_release -si)
        OS_VERSION=$(lsb_release -sr)
    elif [ -f /etc/lsb-release ]; then
        # For some versions of Debian/Ubuntu without lsb_release command
        . /etc/lsb-release
        OS=$DISTRIB_ID
        OS_VERSION=$DISTRIB_RELEASE
    elif [ -f /etc/debian_version ]; then
        # Older Debian/Ubuntu/etc.
        OS=Debian
        OS_VERSION=$(cat /etc/debian_version)
    elif [ -f /etc/SuSe-release ]; then
        # Older SuSE/etc.
        OS=$(uname -s)
        OS_VERSION=$(uname -r)

    fi
    if [ -f /etc/zstack-release ]; then
        ZSTACK_RELEASE_VERSION=$(awk '{print $3}' /etc/zstack-release)    
    fi
    case $(uname -m) in
    x86_64)
        ARCH=x86_64  # or AMD64 or Intel64 or whatever
        ;;
    i*86)
        ARCH=x86  # or IA32 or Intel32 or whatever
        ;;
    aarch64)
        ARCH=aarch64  # or IA32 or Intel32 or whatever
        ;;
    *)
        # leave ARCH as-is
        ;;
    esac
    KERNERL_VERSION=$(uname -r)
    echo {
    echo -e \"platform\":\"${OS,,}\",
    echo -e \"platform_version\":\"${OS_VERSION,,}\",
    echo -e \"zstack_release_version\":\"${ZSTACK_RELEASE_VERSION,,}\",
    echo -e \"kernel_version\":\"${KERNERL_VERSION,,}\",
    echo -e \"kernel_arch\":\"${ARCH,,}\"
    echo -e }
}



getOsVersionInfo
